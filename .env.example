# Copy this file to .env and set strong, unique values.
# Never commit .env to GitHub.

DB_SERVER=postgres
DB_USERNAME=postgres
DB_PASSWORD=change_me_db_password
DB_NAME=ftm_it_property_records
DB_PORT=5432

APP_DB_HOST=apps-postgres
APP_DB_PORT=5432
APP_DB_NAME=applications_db
APP_DB_USER=postgres
APP_DB_PASS=change_me_db_password

POSTGRES_PASSWORD=change_me_db_password

# Admin web login (username is "admin"). Synced to the database on app startup.
ADMIN_PASSWORD=change_me_admin_password

# Keep false so strangers cannot self-register. Set true only for initial user setup.
ALLOW_PUBLIC_SIGNUP=false
